# Database
# Use your hosted Postgres URL in production, or a local one while developing.
DATABASE_URL=postgresql://user:password@your-host:5432/locus_agents?sslmode=require
DB_SSL=true
# Optional. If omitted, the app uses a no-op local Redis mock in dev.
REDIS_URL=

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Locus Payment API
# Leave these empty for local/dev mock checkout mode.
USE_MOCK_PAYMENTS=true
LOCUS_API_BASE=https://api.locus.app/v1
LOCUS_API_KEY=
LOCUS_API_SECRET=
LOCUS_WEBHOOK_SECRET=

# Stripe (test mode)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Manual Payments (dev fallback)
DEV_ALLOW_MANUAL_CONFIRM=true
PAYMENT_RECEIVER=Wallet: 0xYourWalletOrUPI
PAYMENT_INSTRUCTIONS=Send payment to the receiver and paste the reference ID when asked.

# Ethereum
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_PRIVATE_KEY=your_private_key_for_contract_deployment
ETHEREUM_NETWORK=sepolia

# Local AI (optional)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://your-frontend-domain.com
API_URL=https://your-backend-domain.com

# Development
DEV_ALLOW_INSECURE_LOGIN=true

# Logging
LOG_LEVEL=debug
